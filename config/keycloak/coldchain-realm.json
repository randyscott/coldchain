{
  "realm": "coldchain",
  "enabled": true,
  "displayName": "Cold Chain Monitor",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access: manage users, devices, systems, alerts"
      },
      {
        "name": "manager",
        "description": "Configure alerts, acknowledge alerts, generate reports"
      },
      {
        "name": "viewer",
        "description": "Read-only dashboard access"
      }
    ]
  },
  "groups": [
    {
      "name": "Demo Organization",
      "attributes": {
        "group_id": ["a0000000-0000-0000-0000-000000000001"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "coldchain-api",
      "name": "Cold Chain API",
      "description": "Backend API service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "coldchain-web",
      "name": "Cold Chain Web Dashboard",
      "description": "React frontend application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:80/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://localhost"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "coldchain-scope"
      ],
      "protocolMappers": [
        {
          "name": "group_id_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "group_id",
            "claim.name": "group_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "role_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "coldchain-scope",
      "description": "Cold chain custom claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "group_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "group_id",
            "claim.name": "group_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@demo.local",
      "email": "admin@demo.local",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "attributes": {
        "group_id": ["a0000000-0000-0000-0000-000000000001"],
        "role": ["admin"]
      },
      "groups": ["Demo Organization"],
      "realmRoles": ["admin"]
    },
    {
      "username": "viewer@demo.local",
      "email": "viewer@demo.local",
      "firstName": "Demo",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer123",
          "temporary": false
        }
      ],
      "attributes": {
        "group_id": ["a0000000-0000-0000-0000-000000000001"],
        "role": ["viewer"]
      },
      "groups": ["Demo Organization"],
      "realmRoles": ["viewer"]
    }
  ]
}
